<?xml version="1.0" encoding="utf-8"?>
<!--
  🆕 TASK-068 · 共用子布局：实验室 · 续航优化子页（TASK-023/… ）
  🔴 由 settings_layout.xml / page_settings.xml / page_lab.xml 三份布局**共用**，
     改这里一处即三端同步（原为两份独立重复布局，逐字相同）。
  ⚠️ 抽取纯 `<include>` 化：控件 id / 层级 / 属性一字未改 ⇒ 两端逐像素零差异。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_lab_power"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_intro"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- ── 授权状态行（实时检测 WRITE_SECURE_SETTINGS）── -->
    <TextView
        android:id="@+id/tv_power_perm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="3dp"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <!-- ── 命令展示（等宽、可选中）+ 一键复制 ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/power_perm_cmd_label"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tv_power_cmd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="#FFF2F2F2"
        android:padding="8dp"
        android:textColor="#FF000000"
        android:textIsSelectable="true"
        android:textSize="12sp"
        android:typeface="monospace" />

    <Button
        android:id="@+id/btn_power_copy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/btn_ink"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/power_btn_copy"
        android:textColor="@color/btn_ink_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_perm_steps"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />

    <!-- ── 勾选项 1/3：关「开放网络可用」提示（A3）── -->
    <CheckBox
        android:id="@+id/cb_power_wifi_notif"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:buttonTint="#FF000000"
        android:text="@string/power_item_wifi_notif"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_tip_wifi_notif"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />

    <!-- ── 勾选项 2/3：关界面动画（A5）── -->
    <CheckBox
        android:id="@+id/cb_power_anim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:buttonTint="#FF000000"
        android:text="@string/power_item_anim"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_tip_anim"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />

    <!-- ── 勾选项 3/3：关时钟屏保（Q3）── -->
    <CheckBox
        android:id="@+id/cb_power_screensaver"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:buttonTint="#FF000000"
        android:text="@string/power_item_screensaver"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_tip_screensaver"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />

    <!-- ── C1 · 电池优化白名单跳转（抵消 B2 的后台限制）── -->
    <Button
        android:id="@+id/btn_power_battery_opt"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_ink"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:stateListAnimator="@null"
        android:text="@string/power_btn_battery_opt"
        android:textColor="@color/btn_ink_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_battery_opt_tip"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />

    <!-- ── 底部·增强说明（Shizuku，后续版本）── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:lineSpacingExtra="3dp"
        android:text="@string/power_shizuku_hint"
        android:textColor="#FF6A6A6A"
        android:textSize="12sp" />
</LinearLayout><!-- /page_lab_power -->
