<?xml version="1.0" encoding="utf-8"?>
<!-- 新增 / 编辑待办的对话框内容（TASK-024）：内容必填，日期 / 时间**均可空**。
     日期与时间各配一个「清除」按钮（可只填日期、只填时间、或都空）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/et_todo_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/todo_content_hint"
        android:inputType="text"
        android:maxLines="3"
        android:textColor="#FF000000"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/tv_todo_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/todo_no_date"
            android:textColor="#FF000000"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_todo_pick_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_pick_date" />

        <Button
            android:id="@+id/btn_todo_clear_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_clear" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tv_todo_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/todo_no_time"
            android:textColor="#FF000000"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_todo_pick_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_pick_time" />

        <Button
            android:id="@+id/btn_todo_clear_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/todo_clear" />
    </LinearLayout>
</LinearLayout>
