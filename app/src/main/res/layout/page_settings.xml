<?xml version="1.0" encoding="utf-8"?>
<!-- 设置大标签（TASK-045 / V1.2.0-beta · App 内导航重构 K0b）。
     由 settings_layout.xml 的「初始化 + 自定义」两块原样迁入，供 MainActivity 的
     大标签② 容器 <include>；SettingsActivity（phone 端）仍用 settings_layout.xml。
     🔴 两块共用同一个 ScrollView(sv_settings)，切页只切 visibility。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <!-- 顶部页签：初始化 | 自定义
         🆕 2026-09-30 微调：44dp → 40dp（压掉竖直空白，字号不变） -->
    <com.inkread.weekread.ui.SegTabView
        android:id="@+id/seg"
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <ScrollView
        android:id="@+id/sv_settings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="14dp">

            <!-- ============================================================
                 初始化页
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/page_init"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp">

                <!-- ================= ⓪ 本机角色（🆕 TASK-031） ================= -->
                <!-- App 形态「阅读器端 / 手机端」，与「实验室-角色」（remote_role）**正交**、不得混用。
                     置于页首 = 回答"这台设备是什么"，是首装引导之后的第一项。
                     🆕 TASK-043：整块包进 section_install_role_init —— 手机端时由 SettingsActivity
                     **整块搬到「实验室」页顶部**（手机端必须能切回阅读器端，A5）。 -->
                <LinearLayout
                    android:id="@+id/section_install_role_init"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <!-- 🆕 TASK-064：初值 gone —— 由 SettingsPageController.refreshRoleVisibility()
                         按能力门（FeatureGate.rolePickVisible）点亮（🔴 与 settings_layout.xml 镜像）。 -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_install_role"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <RadioGroup
                    android:id="@+id/rg_install_role"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_inst_reader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="@string/install_role_reader"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_inst_phone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="@string/install_role_phone"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tv_install_role_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/install_role_tip"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFD8D8D8" />

                </LinearLayout><!-- /section_install_role_init（TASK-043） -->

                <!-- ================= ① 微信读书 API Key ================= -->
                <!-- 🆕 TASK-043：手机端整块隐藏（手机不取数，Key 无用）。
                     reader 端一字不改；由 SettingsActivity 按 install_role 控制。 -->
                <LinearLayout
                    android:id="@+id/section_api_key_init"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_api_key"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <!-- Key 输入 + 「粘贴」（v0.4.2）：墨水屏手打 27 位 Key 太痛苦，直接读剪贴板 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/hint_api_key"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="#FF000000"
                        android:textColorHint="#FF9A9A9A"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/btn_paste"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginLeft="8dp"
                        android:background="@drawable/btn_ink"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_paste"
                        android:textColor="@color/btn_ink_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- 保存 / 测试连接（v0.4.2）：填完立刻验一次，别靠猜 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ink"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_save"
                        android:textColor="@color/btn_ink_text"
                        android:textSize="17sp" />

                    <Button
                        android:id="@+id/btn_test"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginLeft="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ink"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_test"
                        android:textColor="@color/btn_ink_text"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- 取 Key 的说明（v0.4.3：从页尾搬到 Key 区下方，就近说明） -->
                <TextView
                    android:id="@+id/tv_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:autoLink="web"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/settings_hint"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFD8D8D8" />

                </LinearLayout><!-- /section_api_key_init（TASK-043） -->

                <!-- ================= ② 桌面卡片无障碍 ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_a11y_group"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <Button
                    android:id="@+id/btn_a11y"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/btn_ink"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_open_a11y"
                    android:textColor="@color/btn_ink_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFD8D8D8" />

                <!-- ================= ③ 桌面卡片 ================= -->
                <!-- phone 角色整块隐藏（id=section_card_init，见 SettingsActivity） -->
                <LinearLayout
                    android:id="@+id/section_card_init"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_card"
                        android:textColor="#FF000000"
                        android:textSize="17sp" />
    
                    <CheckBox
                        android:id="@+id/cb_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/label_card_switch"
                        android:textColor="#FF000000"
                        android:textSize="15sp" />
    
                    <!-- v0.6.0：卡片"离开第 1 页自动收起"判据万一被系统漏投、卡片停在隐藏状态，
                         这里给一个明确的出口，用户不用去猜"是不是坏了"。 -->
                    <Button
                        android:id="@+id/btn_reset_card"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_ink"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_reset_card"
                        android:textColor="@color/btn_ink_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFD8D8D8" />

                <!-- ================= ④ 怎么用 ================= -->

                <Button
                    android:id="@+id/btn_help"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_ink"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_help"
                    android:textColor="@color/btn_ink_text"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="#FFD8D8D8" />

                <!-- ================= ⑤ 版本与更新（v0.5.0） ================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_update"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <!-- ── TASK-020：更新通道（正式版 / Beta）──
                     两个并排选项（RadioGroup 提供原生选中态，墨水屏上最直白）
                     + 一条**常显**说明行。🔴 无模态弹窗（沿用「墨水屏上弹窗尤其讨厌」约定）。 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_update_channel"
                    android:textColor="#FF000000"
                    android:textSize="15sp" />

                <RadioGroup
                    android:id="@+id/rg_update_channel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_channel_stable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="@string/channel_stable"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_channel_beta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="@string/channel_beta"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- 常显说明行（文案由 SettingsActivity 按通道切换；含"版本号不可跨通道比较"，验收 A4） -->
                <TextView
                    android:id="@+id/tv_channel_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <!-- ── TASK-030：云端备用更新源（默认开）──
                     GitHub 两源都连不上时，回落自托管清单。🔴 如实描述「连不上时的兜底」，
                     禁写「加速下载 / 多一个下载源」—— 它只在 GitHub 失败时才生效。 -->
                <CheckBox
                    android:id="@+id/cb_cloud_fallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:buttonTint="#FF000000"
                    android:text="@string/label_cloud_fallback"
                    android:textColor="#FF000000"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/cloud_fallback_tip"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <!-- 一个按钮走完全程：检查 → 下载并安装 → 下载中 xx% -->
                <Button
                    android:id="@+id/btn_update"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_ink"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_check_update"
                    android:textColor="@color/btn_ink_text"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_update_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text=""
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- ============================================================
                 自定义页
                 ============================================================ -->
            <LinearLayout
                android:id="@+id/page_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:visibility="gone">

                <!-- ── 桌面卡片（TASK-011 起：仅一页模式；后续 012/013/014/016 同区追加）── -->
                <!-- phone 角色整块隐藏（id=section_card_custom，见 SettingsActivity） -->
                <include layout="@layout/inc_card_custom" />

                <!-- TASK-016：自定义页第二个分区「本记导出图」—— 与上面的「桌面卡片」分开，
                     因为两项都叫「字号」，作用范围不同（卡片 / 本记页与导出图），必须分区隔开 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/label_export_group"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_export_tpl"
                    android:textColor="#FF000000"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/label_export_tpl_tip"
                    android:textColor="#FF3C3C3C"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_paper"
                    android:textColor="#FF000000"
                    android:textSize="15sp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_paper_plain"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="素白"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_paper_journal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="手账"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_paper_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="卡纸"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/label_nsize"
                    android:textColor="#FF000000"
                    android:textSize="15sp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_nsize_s"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="小字"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_nsize_m"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="中字"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rb_nsize_l"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:buttonTint="#FF000000"
                        android:text="大字"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/cb_note_sign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:buttonTint="#FF000000"
                    android:text="@string/label_show_sign"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cb_note_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#FF000000"
                    android:text="@string/label_show_date"
                    android:textColor="#FF000000"
                    android:textSize="14sp" />

                <!-- ── 🆕 TASK-059：书籍排名统计范围（本月页 K9 + 洞察页 K8 共用一处开关）── -->
                <!-- 放在「自定义页」末尾、且不在 section_card_custom 内 ⇒ phone 角色不额外处理（整页本就隐藏） -->
                <LinearLayout
                    android:id="@+id/section_rank_scope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/label_rank_scope"
                        android:textColor="#FF000000"
                        android:textSize="17sp" />

                    <CheckBox
                        android:id="@+id/cb_rank_shelf_only"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:buttonTint="#FF000000"
                        android:text="@string/label_rank_shelf_only"
                        android:textColor="#FF000000"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/label_rank_shelf_only_tip"
                        android:textColor="#FF3C3C3C"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
