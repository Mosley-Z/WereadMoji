<?xml version="1.0" encoding="utf-8"?>
<!--
  V1.1.1-beta · 手机端「遥控台」布局骨架（TASK-037 基座 + TASK-040 连接页）。
  ⚠️ 仅 install_role=phone 时由 ConsoleActivity 加载；阅读器端不使用本布局（零差异）。
  视觉 token 见 docs/09_手机端遥控台UI规范.md。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/console_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink_paper">

    <!-- 顶栏：常驻状态胶囊（左）+ 齿轮入设置（右）—— docs/09 §5.1 -->
    <LinearLayout
        android:id="@+id/console_topbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="8dp">

        <com.inkread.weekread.ui.StatusChipView
            android:id="@+id/console_chip"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/console_dark"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&#9789;"
            android:textColor="@color/ink_text2"
            android:textSize="20sp"
            android:contentDescription="@string/console_dark"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/console_gear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="&#9881;"
            android:textColor="@color/ink_text2"
            android:textSize="22sp"
            android:contentDescription="@string/console_gear"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 内容区：翻页页（主）/ 按键页（060）/ 键盘页（061）/ 连接页（040）—— 互斥显示 -->
    <FrameLayout
        android:id="@+id/console_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.inkread.weekread.ui.FlipKeyView
            android:id="@+id/console_flip"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 🆕 TASK-060：按键页（十字键 + 确认 + 系统键） -->
        <com.inkread.weekread.ui.KeyPadView
            android:id="@+id/console_keypad"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- 🆕 TASK-061：键盘页（手机文本 → 墨水屏输入框；仅 ASCII） -->
        <com.inkread.weekread.ui.KeyboardPageView
            android:id="@+id/console_keyboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/console_connect_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <com.inkread.weekread.ui.ConnectPageView
                android:id="@+id/console_connect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <!-- 🆕 TASK-084：晃动页（第 5 格）—— 1:1 复刻「设置页 → 实验室 → 晃动翻页（手机端）」块，
             与实验室页读写**同一份 core.CardPrefs**、复用**同一套 lab_shake_* 文案** ⇒ 两侧双向同步。
             🔴 不含「响应方向两轴」（2026-10-10 第三轮整组删除，见 验证记录/198）。 -->
        <ScrollView
            android:id="@+id/console_shake_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:fillViewport="true">

            <com.inkread.weekread.ui.ShakePageView
                android:id="@+id/console_shake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>
    </FrameLayout>

    <!-- 底部导航（docs/09 §5.5）：翻页 / 按键 / 键盘 / 晃动 / 连接（TASK-084 由 4 格扩为 5 格） -->
    <LinearLayout
        android:id="@+id/console_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="@color/ink_paper2">

        <TextView
            android:id="@+id/console_nav_flip"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/console_nav_flip"
            android:textColor="@color/ink_bamboo"
            android:textSize="15sp" />

        <!-- 🆕 TASK-060：按键页入口 -->
        <TextView
            android:id="@+id/console_nav_keypad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/console_nav_keypad"
            android:textColor="@color/ink_text2"
            android:textSize="15sp" />

        <!-- 🆕 TASK-061：键盘页入口 -->
        <TextView
            android:id="@+id/console_nav_keyboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/console_nav_keyboard"
            android:textColor="@color/ink_text2"
            android:textSize="15sp" />

        <!-- 🆕 TASK-084：晃动页入口（D1 拍板：键盘之后 / 连接之前） -->
        <TextView
            android:id="@+id/console_nav_shake"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/console_nav_shake"
            android:textColor="@color/ink_text2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/console_nav_connect"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/console_nav_connect"
            android:textColor="@color/ink_text2"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
