<?xml version="1.0" encoding="utf-8"?>
<!-- 主页（TASK-044 骨架 + TASK-045 布局搬迁 / V1.2.0-beta · App 内导航重构 v1）
     结构 = 顶部「大标签栏」（阅读/设置/实验室/待办）+ 内容区（四大标签各一个容器，只切 visibility）。

     🆕 TASK-045：②③④ 三个容器改为 <include> 引入真实布局：
       · mp_settings ← layout/page_settings.xml（初始化 + 自定义，来自 settings_layout.xml）
       · mp_lab      ← layout/page_lab.xml     （实验室 4 子标签，来自 settings_layout.xml）
       · mp_todo     ← layout/page_todo.xml    （待办列表 + 已完成，来自 activity_todo.xml）
     🔴 容器 id 用 mp_* 前缀（不用 page_*）——避免与 settings_layout.xml 里的
        page_init/page_custom/page_lab 内层容器 id 相撞（同一视图树里 id 必须唯一）。
     🔴 TASK-045：删除阅读页底部的「设置」按钮（大标签② 已承担该入口）。
        实测已证 `t11` 回归打的是 ELauncher 桌面图标、与本入口无关（见 验证记录/150 §4）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF"
    android:orientation="vertical">

    <!-- 大标签栏：4 等分（复用通用 SegTabView，宽度自动 = w/labels.length）。
         S4 480px 屏 ⇒ 每段 ~120px；「实验室」3 字在大字号下 ~65px，宽裕。 -->
    <com.inkread.weekread.ui.SegTabView
        android:id="@+id/tab_main"
        android:layout_width="match_parent"
        android:layout_height="44dp" />

    <View
        android:id="@+id/sep_top"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FF000000" />

    <!-- 内容区：四大标签的容器都放这里，切可见性即可（不跳 Activity） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ══════════ ① 阅读（大标签①）══════════ -->
        <FrameLayout
            android:id="@+id/mp_reader"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- 下拉行占位：40dp，给叠加的 NavDropView 留出位置（本身透明不可见） -->
                <View
                    android:id="@+id/nav_drop_slot"
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

                <!-- 周期步进选择器：仅本周/本月可见（本书/本记/洞察由代码置 GONE） -->
                <com.inkread.weekread.ui.PeriodPickerView
                    android:id="@+id/picker"
                    android:layout_width="match_parent"
                    android:layout_height="44dp" />

                <View
                    android:id="@+id/sep_mid"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFD8D8D8" />

                <!-- 卡片主体（App 内走 setFullscreen(true) 的大版排版） -->
                <com.inkread.weekread.feature.WeekCardView
                    android:id="@+id/card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 洞察页占位（TASK-048 填真实内容；本卡只保证「可选中 + 不崩」） -->
                <TextView
                    android:id="@+id/tv_insight_ph"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:lineSpacingExtra="6dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="@string/insight_placeholder"
                    android:textColor="#FF3C3C3C"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/sep_card"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFD8D8D8" />

                <!-- phone 角色（手机端遥控器）时替代卡片区显示；其余卡片 UI 整块隐藏 -->
                <TextView
                    android:id="@+id/tv_remote_notice"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:paddingLeft="24dp"
                    android:paddingRight="24dp"
                    android:text="@string/main_remote_notice"
                    android:textColor="#FF3C3C3C"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <!-- 刷新按钮行。🆕 TASK-045：原并排的「设置」按钮已删除
                     （大标签② 即设置入口）；🔴 `t11` 回归实测与本按钮无关（验证记录/150 §4）。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <Button
                        android:id="@+id/btn_refresh"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_ink"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:stateListAnimator="@null"
                        android:text="@string/btn_refresh"
                        android:textColor="@color/btn_ink_text"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 下拉叠加层：收起 40dp（与 nav_drop_slot 同高同位）；展开时自身高度改 MATCH_PARENT，
                 覆盖下方且不推挤（详见 NavDropView 类注释）。 -->
            <com.inkread.weekread.ui.NavDropView
                android:id="@+id/nav_drop"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="top" />
        </FrameLayout>

        <!-- ══════════ ② 设置（大标签②）══════════ -->
        <LinearLayout
            android:id="@+id/mp_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/page_settings" />
        </LinearLayout>

        <!-- ══════════ ③ 实验室（大标签③）══════════ -->
        <LinearLayout
            android:id="@+id/mp_lab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/page_lab" />
        </LinearLayout>

        <!-- ══════════ ④ 待办（大标签④）══════════ -->
        <LinearLayout
            android:id="@+id/mp_todo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/page_todo" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
