<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.inkread.weekread">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 🆕 TASK-022-R1（V1.0.2-beta）：锁屏背景图需读共享存储里的图片。
         S4 ROM 没有系统文件选择器（DocumentsUI）⇒ SAF 在真机上必然弹不出；而 targetSdk=30
         分区存储下，读公共目录（Pictures 等）的图片必须有本权限（只读媒体文件，非全盘访问）。
         ⚠ 这是本 App 唯一一条"非零权限"，也是唯一一次打破「清单零改动」——覆盖升级后
         需重新授权（系统会弹一次「允许」）。API 33+ 由 READ_MEDIA_IMAGES 接管，故限 32。 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 🆕 TASK-023（V1.0.2-beta）：续航省电开关要写 global 命名空间的设置
         （wifi_networks_available_notification_on / *_animation_scale / wifi_sleep_policy / low_power）。
         🔴 这是本项目**第二个**打破「清单零改动」的权限（第一个 = 上面的 READ_EXTERNAL_STORAGE）。
         保护级 = signature|privileged|**development** ⇒ 普通 App 拿不到「自动授予」，但可由用户
         做**一次性** `pm grant`（App 内「续航」子页给了命令 + 一键复制）；grant 后**永久保留**、免 root。
         ⚠️ 未 grant 时功能**降级**为只读 + 引导，不崩溃。 -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- 在线更新：下载完新版本后要拉起系统安装器。Android 8.0 起还需用户在
         系统设置里为本应用单独打开「允许安装未知应用」，App 会引导过去。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 注意：桌面卡片不再需要 SET_WALLPAPER / SYSTEM_ALERT_WINDOW。
         桌面卡片走 TYPE_ACCESSIBILITY_OVERLAY（由 CardA11yService 自己持有窗口），
         不需要悬浮窗权限。唯一的存储读权限 = 上面的 READ_EXTERNAL_STORAGE（仅锁屏背景图用）。 -->

    <!-- 🆕 TASK-032（V1.1.0-beta）：T1 蓝牙 HID 外设遥控。
         手机当蓝牙 HID 键盘，**直接给墨水屏 OS 发按键**（走输入源层，绕过墨水屏 App / TCP / 注入层）。
         🔴 这是本项目**第三次**打破「清单零改动」的能力面扩大（经 ADR-012 拍板；前两次 = READ_EXTERNAL_STORAGE / WRITE_SECURE_SETTINGS）：
           · BLUETOOTH / BLUETOOTH_ADMIN：legacy（本工程 targetSdk=30）⇒ 安装即授，供 getProfileProxy/registerApp 用；
             ⚠️ **不能**加 maxSdkVersion=30 —— 本机 API 37 会因此不授予 ⇒ getProfileProxy 抛
             SecurityException: Need BLUETOOTH permission（探针实测踩过）。
           · BLUETOOTH_CONNECT：API 31+ 运行时授权（蓝牙访问的正式权限）。
           · FOREGROUND_SERVICE(+_CONNECTED_DEVICE) / POST_NOTIFICATIONS / WAKE_LOCK：HID 注册保活前台服务用。
         🔴 能力落**新服务**上，res/xml/a11y_card_service.xml **一字不改**；默认未启用「蓝牙控制」⇒ 对现状零差异。 -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11 起 queryIntentActivities 受「包可见性」过滤：不声明这里，
         连 CATEGORY_HOME 的桌面都查不到（实测返回空表，卡片会被判定成"不在桌面"而永不显示）。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_app"
        android:roundIcon="@mipmap/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".shell.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 🆕 V1.0.3-beta：设置页换用自定义主题 Theme.WereadMoji.Settings
             （仅把 ActionBar 高度 56dp → 45dp，让顶部大标题矮 15px、下方标签栏随之上移；字号不变）。 -->
        <activity
            android:name=".shell.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_name"
            android:theme="@style/Theme.WereadMoji.Settings" />

        <!-- 🆕 TASK-024（V1.0.3-beta）：待办管理页。
             入口 = 主页第 5 段页签「待办」；exported=false（只由本应用内部拉起）。
             无新增权限：数据只落本机 SharedPreferences（`cfg` / `todo_list`）。 -->
        <activity
            android:name=".shell.TodoActivity"
            android:exported="false"
            android:label="@string/todo_card_title"
            android:theme="@android:style/Theme.Material.Light" />

        <!-- 🆕 TASK-037（V1.1.1-beta）：手机端「遥控台」。
             入口 = MainActivity 在 install_role=phone 时转来；exported=false（只由本应用内部拉起）。
             无新增权限、无新增包依赖（纯 framework View 自绘）。阅读器端不实例化本 Activity。 -->
        <activity
            android:name=".shell.ConsoleActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 「怎么用」：把面向使用者的说明内置进来（v0.4.2），文案在 res/raw/help.txt -->
        <activity
            android:name=".shell.HelpActivity"
            android:exported="false"
            android:label="@string/help_title"
            android:theme="@android:style/Theme.Material.Light" />

        <!-- 在线更新：把下载好的 APK 交给系统安装器。
             不能用 file:// URI（Android 7.0 起会抛 FileUriExposedException），
             而标准解法 FileProvider 在 AndroidX 里 —— 本工程无 AndroidX，故自实现。
             exported=false + grantUriPermissions=true：只通过临时授权给安装器读。 -->
        <provider
            android:name=".update.ApkProvider"
            android:authorities="com.inkread.weekread.apk"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 桌面悬浮卡片的宿主（唯一的呈现方式）。
             窗口类型 TYPE_ACCESSIBILITY_OVERLAY，无需 SYSTEM_ALERT_WINDOW；
             判断"在不在桌面/第几页"；窗口内容唯二在用（canRetrieveWindowContent=true：
             TASK-009 设置页探测 SettingsPageProbe + TASK-010 桌面第 1 页时钟探测 ElaHomeProbe；
             v0.8.2 起 ElaHomeProbe 兼做「服务重连自检」= 同一个类、同一个 getRootInActiveWindow
             调用点 ⇒ 窗口内容使用点仍是"两处两个类"，不新增使用点、不新增权限）。
             权威编号说明见 res/xml/a11y_card_service.xml 的 ①–⑧；用户文案见 @string/a11y_desc。 -->
        <service
            android:name=".a11y.CardA11yService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_card_service" />
        </service>

        <!-- 遥控翻页（TASK-018，V1.0 Beta）：独立的第二个无障碍服务 —— 🔴 与上面的卡片服务
             **分离**是硬约束（ADR-010 决定 5）：按键过滤/手势执行等新能力全部落在这里，
             a11y_card_service.xml 一字不改 ⇒ 现有纯墨水屏用户的无障碍声明不受影响、
             且不撞「全局同时只有一个服务能过滤按键」的互斥（不用遥控的老用户两者天然隔离）。
             权限说明：本服务 = 观察输入（仅按键过滤）+ 执行手势 + INTERNET（已有权限）；
             不读窗口内容（canRetrieveWindowContent=false）。配置见 res/xml/a11y_remote_service.xml。
             默认 remote_role=off：不启用 ⇒ 对现状零差异（验收 A5）。 -->
        <service
            android:name=".remote.RemoteKeyService"
            android:exported="true"
            android:label="@string/remote_svc_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/a11y_remote_service" />
        </service>

        <!-- 🆕 TASK-032（V1.1.0-beta）：HID 注册保活前台服务（foregroundServiceType=connectedDevice）。
             为什么需要：BluetoothHidDevice 的注册在 App 退后台/息屏时会被系统自动注销 ⇒
             必须用前台服务 + PARTIAL_WAKE_LOCK 保活。只在手机端启用「蓝牙控制」时启动；
             默认未启用 ⇒ 不常驻、无通知（验收 A6）。
             ⚠️ exported="false"：TASK-033 起由设置页「蓝牙控制」开关触发（不再用 adb 拉起）。 -->
        <service
            android:name=".remote.HidKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>
</manifest>
