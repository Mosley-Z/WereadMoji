<?xml version="1.0" encoding="utf-8"?>
<!--
  🆕 TASK-068 · 共用子布局：自定义页 · 桌面卡片分区（TASK-011/012/013/014/016/065）
  🔴 由 settings_layout.xml / page_settings.xml / page_lab.xml 三份布局**共用**，
     改这里一处即三端同步（原为两份独立重复布局，逐字相同）。
  ⚠️ 抽取纯 `<include>` 化：控件 id / 层级 / 属性一字未改 ⇒ 两端逐像素零差异。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_card_custom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/label_card"
        android:textColor="#FF000000"
        android:textSize="17sp" />

    <CheckBox
        android:id="@+id/cb_single_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:buttonTint="#FF000000"
        android:text="@string/label_single_page"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/label_single_page_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- TASK-012：刷新绑定 —— 点「更新于…」按勾选一并补发（只写偏好，不触发卡片重绘） -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_refresh_bind"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_bind_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_bind_week"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_bind_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_bind_month"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_bind_book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_bind_book"
            android:textColor="#FF000000"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/label_refresh_bind_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- TASK-013：阅读成就提示 —— 成就行画在桌面卡片贴底位，默认全关 = 版面与 v0.8.0 一致 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_achv"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <CheckBox
        android:id="@+id/cb_achv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:buttonTint="#FF000000"
        android:text="@string/label_achv_switch"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/label_achv_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_achv_week"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_achv_week_off"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_off"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_week_perfect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_perfect"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_week_berserk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_berserk"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_week_custom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_custom"
            android:textColor="#FF000000"
            android:textSize="13sp" />
    </RadioGroup>

    <EditText
        android:id="@+id/et_achv_week"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:hint="@string/hint_achv_week"
        android:inputType="numberDecimal"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/label_achv_month"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_achv_month_off"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_off"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_month_perfect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_perfect"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_month_berserk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_berserk"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_achv_month_custom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_achv_kind_custom"
            android:textColor="#FF000000"
            android:textSize="13sp" />
    </RadioGroup>

    <EditText
        android:id="@+id/et_achv_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:hint="@string/hint_achv_month"
        android:inputType="numberDecimal"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/label_achv_source"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- TASK-014：本月呈现 —— 打卡网格 ↔ 阅读热力图（默认热力图）。
         只影响本月形态的日期格画法；周/本书/本记不受影响。 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_month_style"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_month_style_checkin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_month_style_checkin"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/rb_month_style_heatmap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/label_month_style_heatmap"
            android:textColor="#FF000000"
            android:textSize="14sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/label_month_style_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- TASK-016：本记字号（卡片）—— 桌面卡片「本记」正文的字号，固定 + 连续可调。
         🔴 max / progress **不在 XML 里写**：取值范围的唯一真源是
         CardPrefs.NOTE_CARD_SIZE_MIN/MAX，由 SettingsActivity 在运行时 set，
         免得以后调上下限时忘了同步这里。 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/label_note_card_size"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tv_note_card_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FF000000"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/sb_note_card_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:progressDrawable="@drawable/seek_ink"
        android:splitTrack="false"
        android:thumb="@drawable/seek_thumb" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/label_note_card_size_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <!-- ── TASK-025（V1.0.3-beta）：卡片切换方式 + 桌面显示的卡片（卡片池）──
         两项都只影响桌面卡片，故放在"桌面卡片"这一分区里（手机角色整块隐藏）。
         勾选态由 SettingsActivity 读写 CardPrefs；🆕「至少保留一张」在 Activity 兜底。 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/custom_switch_mode_title"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/rg_switch_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_switch_loop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/switch_mode_loop"
            android:textColor="#FF000000"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rb_switch_list"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/switch_mode_list"
            android:textColor="#FF000000"
            android:textSize="13sp" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/switch_mode_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/custom_card_pool_title"
        android:textColor="#FF000000"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_pool_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/pool_week"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_pool_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/pool_month"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_pool_book"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/pool_book"
            android:textColor="#FF000000"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_pool_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/pool_note"
            android:textColor="#FF000000"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cb_pool_todo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="#FF000000"
            android:text="@string/pool_todo"
            android:textColor="#FF000000"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/card_pool_tip"
        android:textColor="#FF3C3C3C"
        android:textSize="13sp" />
</LinearLayout>
