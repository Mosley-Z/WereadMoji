<?xml version="1.0" encoding="utf-8"?>
<!-- 遥控无障碍服务声明（TASK-018，独立于卡片服务）。
     🔴 硬约束（验收 A6）：res/xml/a11y_card_service.xml 一字不改 —— 本文件是**新增**的第二份声明，
        所有新能力（按键过滤 / 手势）都落在本服务上，现有纯墨水屏用户的无障碍声明不受影响。
     能力说明（与 help.txt / 头注三处同步 —— 本项目文案漂移常客）：
     · canRequestFilterKeyEvents：手机端捕获音量键（"观察输入"的按键过滤，**不是**"读取屏幕内容"）；
     · canPerformGestures：墨水屏端注入翻页点击手势（点击阅读页左右边界热区，参数来自 验证记录/118 真机标定）。
     订阅面最小：不读窗口内容（canRetrieveWindowContent 缺省 false），
     事件类型只留 typeWindowStateChanged 占位（phone 端只走 onKeyEvent，eink 端被动收指令）。
     ⚠️ 按键过滤全局互斥（实测）：同类服务同机只能有一个生效 —— 实验室页必须给用户操作指引。 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/a11y_remote_desc"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:settingsActivity="com.inkread.weekread.shell.SettingsActivity" />
